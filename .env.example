# ==============================================================================
# AI Cost Configuration
# ==============================================================================

# Database
# Connect to standard PostgreSQL or leave empty for embedded zero-config PGlite engine
DATABASE_URL=postgresql://aicost:aicost_secure_pass@localhost:5432/aicost

# Optional Redis Cache / Queue URL
REDIS_URL=redis://localhost:6379

# Service Ports & Hosts
GATEWAY_PORT=4000
GATEWAY_HOST=0.0.0.0

API_PORT=3001
API_HOST=0.0.0.0

# Security
JWT_SECRET=ai-cost-super-secret-key-change-in-production

# Default Upstream Provider Keys (Optional: clients can also pass per-request keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama Provider URL
OLLAMA_BASE_URL=http://localhost:11434

# Data Retention Policy (days to retain raw request telemetry before auto-purge)
DATA_RETENTION_DAYS=90

# Gateway Reliability: If true, allows requests to pass even if analytics storage has transient failure
FAIL_OPEN=true

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
